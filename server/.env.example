# Copy to .env, fill in, then: chmod 600 .env
# .env must never be committed to git. Owned by the service user, mode 0600.

# Port and bind address. Bind to 127.0.0.1 when a reverse proxy terminates TLS
# in front of this process — then nothing reaches the app except through it.
PORT=8080
BIND=127.0.0.1

# production turns on HSTS and makes PUBLIC_ORIGIN mandatory.
NODE_ENV=production

# The origin(s) the browser loads the app from. Comma-separated, scheme included.
# Required in production: it is what the same-origin check on writes compares to.
PUBLIC_ORIGIN=https://hif.example.com

# How many reverse proxies sit in front of this process (0 = none).
# Leave at 0 unless there really is one: with 0, X-Forwarded-For is ignored and
# a client cannot spoof the IP its rate limit is counted against.
TRUST_PROXY=1

# Supabase — Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon key is designed to be public; it is safe in the browser.
SUPABASE_ANON_KEY=eyJ...

# The service_role key must NEVER be set here. It bypasses every RLS policy,
# and the server refuses to start if it finds one in the environment.
# SUPABASE_SERVICE_ROLE_KEY=  <- do not

# Finnhub — finnhub.io, free tier. Stays on the server, never sent to the browser.
FINNHUB_TOKEN=

# Health counters for the admin panel, served on a second loopback-only port
# that the reverse proxy never routes to. Must equal STATS_TOKEN in admin.env.
# Leave empty to turn the stats listener off. Generate: openssl rand -hex 32
STATS_TOKEN=
STATS_PORT=8082

# Direct Postgres connection, for backups only (Project Settings > Database).
# Keep this out of the app's environment entirely if you can; a backup job with
# its own credentials file is safer than the web process holding superuser creds.
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-REF.supabase.co:5432/postgres
