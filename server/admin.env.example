# Admin process settings. Copy to admin.env, fill in, then: chmod 600 admin.env
# This file is read ONLY by admin.js and admin-cli.js. Never put these values
# in .env: the public server must not see the service_role key (it refuses to
# start if it does).

# Loopback only — admin.js refuses any other bind address.
ADMIN_PORT=8081
ADMIN_BIND=127.0.0.1

# Supabase — Project Settings > API. The service_role key bypasses RLS; it
# lives here and nowhere else.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts admins' 2FA secrets at rest. Generate once: openssl rand -hex 32
# Changing it invalidates every admin's 2FA (run admin-cli.js reset-2fa).
ADMIN_TOTP_KEY=

# Health page: must equal STATS_TOKEN in the public server's .env.
# Generate once: openssl rand -hex 32
STATS_URL=http://127.0.0.1:8082/stats
STATS_TOKEN=

# Set to 1 only if the panel is served over https (it normally is not: the
# SSH tunnel already encrypts the connection, and browsers treat 127.0.0.1 as secure).
ADMIN_COOKIE_SECURE=0
