# Required. Keep the real value only in .env or the service environment.
FINNHUB_KEY=replace-with-your-key

# Local server settings.
HOST=127.0.0.1
PORT=8080

# Comma-separated extra browser origins allowed to call /api/finnhub.
# Same-origin requests are always accepted.
ALLOWED_ORIGINS=

# Per-client API requests allowed in a rolling minute.
API_RATE_LIMIT=60

# Set to true only when the server is behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
