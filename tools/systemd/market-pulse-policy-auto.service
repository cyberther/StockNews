# Politici 2.0 (tools/policy-auto-batch.mjs): reads the Chamber's documents and, with the local
# model, turns each new policy document into an automatic impact analysis or a fact sheet.
# User unit, not installed by anything; to turn it on:
#   cp tools/systemd/market-pulse-policy-auto.* ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now market-pulse-policy-auto.timer
# Uses ~/.config/market-pulse/summarizer.env (as the summary job). AI_WINDOW, AI_MAX_MINUTES
# and AI_LIMIT can go there too.
[Unit]
Description=Market Pulse automatic policy analyses by the local model (LM Studio)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/StockNews
ExecStart=/usr/bin/env node tools/policy-auto-batch.mjs
# Lowest priority: the news summaries and the desktop come first.
Nice=19
CPUWeight=10
IOSchedulingClass=idle
TimeoutStartSec=5h
