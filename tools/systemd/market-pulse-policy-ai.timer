# Once a night; the job itself also checks AI_WINDOW (default 01-06, Bucharest time) and
# stops at AI_MAX_MINUTES. LM Studio not answering: the run is postponed to the next night.
[Unit]
Description=Run Market Pulse policy annotations once a night

[Timer]
OnCalendar=*-*-* 01:30:00
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
