# Once a night, after the ingestion's eod job (21:40 UTC) has stored the day's documents. The job
# itself checks AI_WINDOW (default 01-06, Bucharest time) and stops at AI_MAX_MINUTES; LM Studio
# not answering postpones the run to the next night.
[Unit]
Description=Run Market Pulse automatic policy analyses once a night

[Timer]
OnCalendar=*-*-* 02:00:00
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
